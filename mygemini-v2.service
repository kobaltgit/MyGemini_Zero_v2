[Unit]
Description=MyGemini Zero v2 Telegram Bot
After=network.target

[Service]
Type=simple
User=kobalt
WorkingDirectory=/home/kobalt/MyGemini_Zero_v2
ExecStart=/home/kobalt/MyGemini_Zero_v2/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
